VITE_APP_PROXY_URL=https://api.purr.trade/cors/
VITE_APP_API_URL=https://api.purr.trade/
VITE_APP_LIB_URL=
VITE_APP_LIB_REPO_URL=
VITE_APP_BASE_PATH=/
# ponytail: HL-native intervals only; aggregate finer candles if sub-minute/odd timeframes are wanted
VITE_APP_API_SUPPORTED_TIMEFRAMES=60,180,300,900,1800,3600,7200,14400,28800,43200,86400
VITE_APP_PUBLIC_VAPID_KEY=
# Liquidation feed websocket (REKTS pane / chart liquidations). Empty = no socket
VITE_APP_LIQUIDATIONS_URL=
# Giphy API key for trade GIFs. Empty = GIFs off, no Giphy requests
VITE_APP_GIPHY_KEY=
